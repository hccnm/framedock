        "inputs": {
          "image": ""
        },
        "_meta": {
          "title": "参考图 2（可选）"
        }
      },
      "23": {
        "class_type": "LoadImage",
        "inputs": {
          "image": ""
        },
        "_meta": {
          "title": "参考图 3（可选）"
        }
      },
      "4_image1_resize": {
        "class_type": "ImageScaleToTotalPixels",
        "inputs": {
          "image": [
            "21",
            0
          ],
          "upscale_method": "area",
          "megapixels": 1,
          "resolution_steps": 16
        }
      },
      "4_image2_resize": {
        "class_type": "ImageScaleToTotalPixels",
        "inputs": {
          "image": [
            "22",
            0
          ],
          "upscale_method": "area",
          "megapixels": 1,
          "resolution_steps": 16
        }
      },
      "4_image3_resize": {
        "class_type": "ImageScaleToTotalPixels",
        "inputs": {
          "image": [
            "23",
            0
          ],
          "upscale_method": "area",
          "megapixels": 1,
          "resolution_steps": 16
        }
      }
    },
