[
  {
    "id": "general-z-image",
    "name": "通用多参考-Z Image",
    "description": "通用图像生成与多参考组合，不限定角色、场景或风格。0 张为文生图，最多 3 张参考。LoRA 默认与原文生一致：瑶光 0.5、如梦似幻 0.7、8步蒸馏 0.45，依次加载且全部开启；Agent 可修改各自开关、文件及强度。使用原生实验性 Omni 编码，参考一致性取决于现有 Z Image 权重，需按实测结果使用。",
    "outputKinds": [
      "image"
    ],
    "workflow": {
      "1": {
        "class_type": "UNETLoader",
        "inputs": {
          "unet_name": "z_image_bf16.safetensors",
          "weight_dtype": "default"
        },
        "_meta": {
          "title": "模型"
        }
      },
      "2": {
        "class_type": "CLIPLoader",
        "inputs": {
          "clip_name": "qwen_3_4b.safetensors",
          "type": "lumina2",
          "device": "default"
        },
        "_meta": {
          "title": "文本编码器"
        }
      },
      "3": {
        "class_type": "VAELoader",
        "inputs": {
          "vae_name": "ae.safetensors"
        },
        "_meta": {
          "title": "VAE"
        }
      },
      "4": {
        "class_type": "TextEncodeZImageOmni",
        "inputs": {
          "clip": [
            "9",
            1
          ],
          "vae": [
            "3",
            0
          ],
          "prompt": "根据提示词生成图像；有参考图时，按描述选取其中的主体、材质、色彩或构图，生成统一自然的新画面。",
          "auto_resize_images": false,
          "image1": [
            "4_image1_resize",
            0
          ],
          "image2": [
            "4_image2_resize",
            0
          ],
          "image3": [
            "4_image3_resize",
            0
          ]
        },
        "_meta": {
          "title": "通用提示词与参考图"
        }
      },
      "5": {
        "class_type": "EmptySD3LatentImage",
        "inputs": {
          "width": 1024,
          "height": 1024,
          "batch_size": 1
        },
        "_meta": {
          "title": "输出尺寸"
        }
      },
      "6": {
        "class_type": "KSampler",
        "inputs": {
          "model": [
            "9",
            0
          ],
          "positive": [
            "4",
            0
          ],
          "negative": [
            "8",
            0
          ],
          "latent_image": [
            "5",
            0
          ],
          "seed": 42,
          "steps": 8,
          "cfg": 1,
          "sampler_name": "res_2s_ode",
          "scheduler": "kl_optimal",
          "denoise": 1
        },
        "_meta": {
          "title": "采样参数"
        }
      },
      "7": {
        "class_type": "VAEDecode",
        "inputs": {
          "samples": [
            "6",
            0
          ],
          "vae": [
            "3",
            0
          ]
        },
        "_meta": {
          "title": "解码"
        }
      },
      "8": {
        "class_type": "CLIPTextEncode",
        "inputs": {
          "clip": [
            "9",
            1
          ],
          "text": ""
        },
        "_meta": {
          "title": "负向提示词（CFG为1时不生效）"
        }
      },
      "9": {
        "class_type": "CR Load LoRA",
        "inputs": {
          "model": [
            "12",
            0
          ],
          "clip": [
            "12",
            1
          ],
          "switch": "On",
          "lora_name": "Z-Image-Fun-Lora-Distill-8-Steps-2603-ComfyUI.safetensors",
          "strength_model": 0.45,
          "strength_clip": 0
        },
        "_meta": {
          "title": "8步蒸馏 LoRA"
        }
      },
      "10": {
        "class_type": "SaveImage",
        "inputs": {
          "images": [
            "7",
            0
          ],
          "filename_prefix": "FrameDock/ZImage/general"
        },
        "_meta": {
          "title": "保存图像"
        }
      },
      "11": {
        "class_type": "CR Load LoRA",
        "inputs": {
          "model": [
            "1",
            0
          ],
          "clip": [
            "2",
            0
          ],
          "switch": "On",
          "lora_name": "Kook_Zimage_瑶光.safetensors",
          "strength_model": 0.5,
          "strength_clip": 0
        },
        "_meta": {
          "title": "风格 LoRA 1"
        }
      },
      "12": {
        "class_type": "CR Load LoRA",
        "inputs": {
          "model": [
            "11",
            0
          ],
          "clip": [
            "11",
            1
          ],
          "switch": "On",
          "lora_name": "Kook_Zimage_如梦似幻.safetensors",
          "strength_model": 0.7,
          "strength_clip": 0
        },
        "_meta": {
          "title": "风格 LoRA 2"
        }
      },
      "21": {
        "class_type": "LoadImage",
        "inputs": {
          "image": ""
        },
        "_meta": {
          "title": "参考图 1（可选）"
        }
      },
      "22": {
